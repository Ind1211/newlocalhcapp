# Backend API — matches wherever `uvicorn app.main:app` is running
VITE_API_URL=http://127.0.0.1:8000

# From your Auth0 Application settings (the React SPA you created earlier)
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id-here

# Now REQUIRED, not optional. Without an audience, Auth0 issues an opaque token
# instead of a real JWT, and the API gateway's JWT plugin has nothing it can
# validate — every request will be rejected with a 401. Create an API resource in
# your Auth0 dashboard (APIs → Create API — the "identifier" you set there is this
# value, not the API's display name) if you haven't already.
VITE_AUTH0_AUDIENCE=https://your-api-identifier
