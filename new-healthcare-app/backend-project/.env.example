# Copy to .env and adjust if your Postgres credentials differ from docker-compose.yml.
# This file documents every environment variable app/*.py actually reads -- useful
# both for running the backend directly (uvicorn, outside docker-compose) and as a
# reference for what an Azure Container App deployment needs to set. See
# claude/azure-container-apps-deployment-plan.md in the project notes for the full
# list mapped to specific Azure resources.

DATABASE_URL=postgresql+psycopg2://kidney_app_user:change_this_to_a_real_secret@localhost:5432/kidney_cardiology_db

# Required only for the AI-generated CKD care plan, integrated care plan, and custom
# assessment interpretation features. This is YOUR OWN Anthropic API key from
# https://console.anthropic.com -- it is not provided automatically, and using it
# will incur real API usage charges on your Anthropic account. Leave blank to run
# without those three AI features; everything else works fine without it.
ANTHROPIC_API_KEY=your-real-anthropic-api-key-here

# --- Object storage (app/storage.py -- Azure Blob Storage) ---
# Local docker-compose already sets this for you, pointing at the azurite container
# (see docker-compose.yml) -- you only need to set it here if running the backend
# directly with `uvicorn`, outside Docker. Point it at Azurite on localhost for that
# case, or at your real Storage Account's connection string (Storage Account ->
# Access keys) for an actual Azure deployment.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;

# --- Auth0 (app/auth.py, app/auth0_management.py) ---
# AUTH0_AUDIENCE / AUTH0_ISSUER must match the API identifier and tenant domain the
# frontend uses (VITE_AUTH0_AUDIENCE / VITE_AUTH0_DOMAIN) -- this is what the backend
# independently verifies every request's JWT against, on top of whatever a gateway
# (Kong, if you're running one) already checked.
AUTH0_AUDIENCE=https://your-api-identifier
AUTH0_ISSUER=https://your-tenant.us.auth0.com/
# Provide the Auth0 tenant's RSA public key ONE of these two ways:
# - AUTH0_PUBLIC_KEY: the full PEM contents, inline -- used on Azure Container Apps,
#   which has no docker-compose-style file mount (set this as a Container Apps secret)
# - AUTH0_PUBLIC_KEY_PATH: a file path -- used by docker-compose, which mounts
#   auth0-public-key.pem into the container (see docker-compose.yml). If both are
#   set, AUTH0_PUBLIC_KEY (the inline value) wins.
AUTH0_PUBLIC_KEY=
AUTH0_PUBLIC_KEY_PATH=/app/auth0-public-key.pem
# For the Auth0 Management API client (creating/deactivating staff accounts).
# Requires a separate Machine-to-Machine application in your Auth0 dashboard,
# authorized for the Management API with scopes: create:users, create:user_tickets,
# read:users, update:users.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
# The frontend SPA application's own client ID -- reused here for the password-reset
# ticket flow (falls back to AUTH0_M2M_CLIENT_ID if unset).
AUTH0_SPA_CLIENT_ID=

# --- CORS (app/main.py) ---
# Comma-separated list of extra allowed origins, on top of the localhost:5173 dev
# defaults that are always allowed. Set this to your deployed frontend's real URL
# (e.g. an Azure Static Web Apps URL) once you have one -- no code change needed.
CORS_ALLOWED_ORIGINS=

# --- Background scheduler (app/scheduler.py) ---
SCHEDULER_INTERVAL_MINUTES=1

# --- Email notifications (app/email_service.py) -- all optional; notifications are
# skipped with a logged warning if SMTP_HOST/SMTP_USERNAME/SMTP_PASSWORD aren't set ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
