# Copy this to .env in the SAME folder as docker-compose.yml, then fill in real
# values. This single .env is read by docker-compose itself (for the ${VAR}
# references in docker-compose.yml) — it is NOT the same .env as backend/.env or
# frontend/.env, which are for running those services outside Docker.

# Must match the credentials your EXISTING kidney_cardiology_db container already
# uses — this connects to that container, it does not create a new one.
POSTGRES_USER=kidney_app_user
POSTGRES_PASSWORD=your_real_password_here
# If POSTGRES_PASSWORD contains an @ (or other URL-special character), this needs
# the URL-encoded version — @ becomes %40. If your password has no special
# characters, this can just be identical to POSTGRES_PASSWORD above.
POSTGRES_PASSWORD_URLENCODED=your_real_password_url_encoded_here
POSTGRES_DB=kidney_cardiology_db

# Your own Anthropic API key — required for custom assessment interpretation, the
# CKD care plan, and the integrated care plan. Leave blank to run without those
# three AI features; everything else works fine without it.
ANTHROPIC_API_KEY=

# From your Auth0 Application settings (the React SPA you created earlier).
# VITE_AUTH0_AUDIENCE is REQUIRED, not optional — Kong's JWT plugin needs a real,
# signed JWT to validate, which Auth0 only issues when an audience is set. See the
# README for the full one-time Auth0 + Kong setup.
#
# IMPORTANT: whatever URL you actually share (an ngrok URL, your LAN IP, etc.) must
# also be added to this Auth0 application's "Allowed Callback URLs", "Allowed
# Logout URLs", and "Allowed Web Origins" — otherwise login will fail with a
# redirect mismatch error the moment your boss tries to log in from that URL.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id-here
VITE_AUTH0_AUDIENCE=https://your-api-identifier

# Object storage for local dev is now Azurite (Azure Storage's official local
# emulator) instead of MinIO -- see the azurite/backend services in
# docker-compose.yml. Azurite uses a fixed, publicly-documented well-known dev
# account/key (not a real secret), so there's nothing to set here for local use.
# A real Azure deployment uses AZURE_STORAGE_CONNECTION_STRING set directly on the
# Azure Container App instead of through this file -- see
# claude/azure-container-apps-deployment-plan.md in the project notes.

# Auth0 Management API — for creating/editing/deactivating staff accounts
# directly from this app. Requires a separate Machine-to-Machine application in
# your Auth0 dashboard, authorized for the Management API with these exact
# scopes: create:users, create:user_tickets, read:users, update:users.
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
